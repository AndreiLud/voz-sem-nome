{% import "partials/macros.html.j2" as ui with context %}
<!doctype html>
<html lang="{{ html_lang }}" dir="ltr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{{ meta.title }}</title>
<meta name="description" content="{{ meta.description }}">
{% if noindex %}
<meta name="robots" content="noindex">
{% else %}
<link rel="canonical" href="{{ canonical }}">
{% for alt in alternates %}
<link rel="alternate" hreflang="{{ alt.hreflang }}" href="{{ alt.href }}">
{% endfor %}
{% endif %}
<meta name="theme-color" content="#f9f9f7" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0d0d0d" media="(prefers-color-scheme: dark)">
<link rel="icon" href="/assets/icons/favicon.svg" type="image/svg+xml">
<link rel="preload" href="/assets/fonts/AtkinsonHyperlegibleNext-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/site.css">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ s.meta.site_name }}">
<meta property="og:title" content="{{ meta.title }}">
<meta property="og:description" content="{{ meta.description }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:locale" content="{{ og_locale }}">
<meta property="og:locale:alternate" content="{{ og_locale_alt }}">
<meta property="og:image" content="{{ og_image }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ s.meta.og_image_alt }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ meta.title }}">
<meta name="twitter:description" content="{{ meta.description }}">
<meta name="twitter:image" content="{{ og_image }}">
<meta name="twitter:image:alt" content="{{ s.meta.og_image_alt }}">
<script type="module" src="/assets/js/main.js"></script>
{% block head %}{% endblock %}
</head>
<body data-page="{{ page }}">
<a class="skip-link" href="#main">{{ s.common.skip_link }}</a>
<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="wordmark" href="{{ url('home') }}" aria-label="{{ s.common.wordmark_label }}">
      <span class="wordmark__text" aria-hidden="true">Voz sem</span>
      <span class="wordmark__bar" aria-hidden="true"></span>
    </a>
    <div class="lang-switch" role="group" aria-label="{{ s.common.lang_switch_label }}">
      {% for code in site.languages %}
      {% if code == lang %}
      <span class="lang-switch__item is-current" aria-hidden="true">{{ code | upper }}</span>
      {% else %}
      <a class="lang-switch__item" id="lang-toggle" href="{{ alt_url }}" hreflang="{{ other_html_lang }}" lang="{{ other_html_lang }}" data-lang="{{ code }}">{{ s.common.lang_other_code }}<span class="visually-hidden"> {{ s.common.lang_other_name }}</span></a>
      {% endif %}
      {% endfor %}
    </div>
    <nav class="site-nav" aria-label="{{ s.common.nav_label }}">
      <ul class="site-nav__list">
        <li><a href="{{ url('home', 'how') }}">{{ s.common.nav.how }}</a></li>
        <li><a href="{{ url('dashboard') }}"{% if page == 'dashboard' %} aria-current="page"{% endif %}>{{ s.common.nav.dashboard }}</a></li>
        <li><a href="{{ url('submit') }}"{% if page == 'submit' %} aria-current="page"{% endif %}>{{ s.common.nav.submit }}</a></li>
        <li><a href="{{ url('privacy') }}"{% if page == 'privacy' %} aria-current="page"{% endif %}>{{ s.common.nav.privacy }}</a></li>
      </ul>
    </nav>
  </div>
</header>
<main id="main" tabindex="-1">
{% block main %}{% endblock %}
</main>
<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <p class="wordmark wordmark--static" aria-hidden="true"><span class="wordmark__text">Voz sem</span> <span class="wordmark__bar"></span></p>
    <div class="site-footer__text">
      <p>{{ md(s.footer.about) }}</p>
      <p>{{ s.footer.data_notice }}</p>
    </div>
    <nav class="site-footer__nav" aria-label="{{ s.footer.nav_label }}">
      <ul>
        <li><a href="{{ site.github_url }}">{{ ui.icon('github') }}{{ s.footer.repo }}</a></li>
        <li><a href="{{ url('privacy') }}">{{ s.footer.privacy }}</a></li>
      </ul>
    </nav>
  </div>
</footer>
<script type="application/json" id="page-data">{{ page_data }}</script>
</body>
</html>
