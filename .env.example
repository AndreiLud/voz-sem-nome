# Copy to .env and fill in. .env is never committed.
# Generate each secret with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Host user, so files written by the containers stay yours.
UID=1000
GID=1000

# prod hides the API docs and requires the shared secrets below. dev relaxes both for local work.
ENPS_ENV=prod

# Local mode: required by the public API (port 8001) on every submission, e.g. from scripts/dev_server.py.
ORIGIN_SHARED_SECRET=

# Shared by n8n and the internal API. In n8n it lives in a Header Auth credential named "Internal API".
INTERNAL_API_TOKEN=

# n8n webhook that receives critical-case alerts from the worker (internal Docker network only).
N8N_ALERT_WEBHOOK_URL=http://n8n:5678/webhook/critical-alert

# n8n encrypts stored credentials with this key. Back it up: without it the credentials are lost.
N8N_ENCRYPTION_KEY=

